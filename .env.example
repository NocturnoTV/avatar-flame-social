ROBLOX_CLIENT_ID="4495295082449707042"
ROBLOX_CLIENT_SECRET="set-in-the-host-secret-manager"
ROBLOX_REDIRECT_URI="https://bloxspark.app/auth/roblox/callback"
SITE_URL="https://bloxspark.app"

# Spark Plus billing (Stripe, via Lovable's managed connector gateway —
# see src/lib/stripe.server.ts). These are provisioned automatically once
# Stripe is connected/go-live'd from the Lovable project dashboard —
# never put real values here or in any committed file.
STRIPE_SANDBOX_API_KEY="set-in-the-host-secret-manager"
STRIPE_LIVE_API_KEY="set-in-the-host-secret-manager"
LOVABLE_API_KEY="set-in-the-host-secret-manager"
PAYMENTS_SANDBOX_WEBHOOK_SECRET="set-in-the-host-secret-manager"
PAYMENTS_LIVE_WEBHOOK_SECRET="set-in-the-host-secret-manager"
SUPABASE_SERVICE_ROLE_KEY="set-in-the-host-secret-manager"
# Client-side Stripe publishable key — pk_test_... in sandbox, pk_live_...
# once Stripe go-live is complete (this one is safe to expose, unlike the
# keys above).
VITE_PAYMENTS_CLIENT_TOKEN="pk_test_..."

# Push notifications (Firebase Cloud Messaging — see src/lib/push.server.ts).
# From the Firebase service-account JSON (Firebase console -> Project
# settings -> Service accounts -> Generate new private key): project_id,
# client_email, and private_key (paste its \n line breaks as literal \n).
# Never put the real values here or in any committed file.
FIREBASE_PROJECT_ID="set-in-the-host-secret-manager"
FIREBASE_CLIENT_EMAIL="set-in-the-host-secret-manager"
FIREBASE_PRIVATE_KEY="set-in-the-host-secret-manager"
